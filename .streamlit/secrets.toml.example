# Copy to .streamlit/secrets.toml (git-ignored) for local runs.
# On Streamlit Community Cloud paste the same content under: Manage app -> Settings -> Secrets.

# Required. Free key: https://console.groq.com
GROQ_API_KEY = "YOUR_GROQ_KEY"

# Recommended. Free key, no credit card: https://aistudio.google.com/apikey
# Gives the interviewer a far more natural Hebrew voice, much better transcription of spoken answers,
# and a stronger final report. Free quotas are small; when they run out the app falls back automatically
# (voice -> Edge, transcription -> Whisper on Groq).
# Note: on Google's free tier, prompts and audio may be used to improve Google's products.
# GEMINI_API_KEY = "YOUR_GEMINI_KEY"

# Optional. Password for the statistics page (open the app with ?admin=1).
# ADMIN_PASSWORD = "choose-a-long-password"

# Optional engine order overrides.
# TTS_ENGINES = "gemini, edge, gtts"
# STT_ENGINES = "gemini, whisper"

# Optional. Try other models without touching code (provider:model, in order of preference).
# LLM_ROUTES_TURN = "groq:openai/gpt-oss-120b, groq:qwen/qwen3.8-27b, groq:openai/gpt-oss-20b"
# LLM_ROUTES_REPORT = "gemini:gemini-3.8-flash, groq:openai/gpt-oss-120b"

# Optional. Without this block the app works and simply does not save interviews.
[connections.firestore]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
